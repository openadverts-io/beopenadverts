# =============================================================================
# OpenAdverts environment configuration — PRODUCTION (Polygon mainnet, chainId 137)
# Copy this file to `.env.prod` and fill in the values.
#
# PRIVATEKEYMAINNET is intentionally NOT stored in this file.
# Supply it as an inline env var only at deploy/upgrade time:
#
#   PowerShell:
#     $env:PRIVATEKEYMAINNET="<key>"
#     $env:ENV_FILE=".env.prod"; $env:I_UNDERSTAND_MAINNET="1"
#     npx hardhat run scripts/deploy.js --network polygon
#     Remove-Item Env:PRIVATEKEYMAINNET   # clear immediately after
#
#   bash/zsh:
#     PRIVATEKEYMAINNET=<key> ENV_FILE=.env.prod I_UNDERSTAND_MAINNET=1 \
#       npx hardhat run scripts/deploy.js --network polygon
#
# Verification (no owner key needed):
#   ENV_FILE=.env.prod npx hardhat run scripts/verify.js --network polygon
#
# dotenv loads a SINGLE file (no merge with .env), so this file must be
# self-contained for verify runs.
#
# NOTE: `.env.prod` is gitignored. Never commit real keys.
# =============================================================================

# Explicit mainnet opt-in required by scripts/deploy.js. Set to 1 only when you
# really mean to broadcast to Polygon mainnet; leave blank otherwise.
I_UNDERSTAND_MAINNET=

# Protocol signing ADDRESS only (public). The signing PRIVATE key must NOT live
# here — it belongs to the backend signing service that issues create-gate and
# reward signatures.
OPENADVERTS_SIGNING_ADDRESS=

# Storage-provider payout address (required on Polygon)
STORAGE_PROVIDER_ADDRESS=

# Native USDC on Polygon mainnet
ADDRESS_USDCPOLYGINMAIN=

# Contract verification (Etherscan V2 unified key)
ETHERSCAN_API_KEY=
