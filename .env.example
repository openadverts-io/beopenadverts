# =============================================================================
# OpenAdverts environment configuration — DEV / TESTNET (example)
# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (PowerShell)
#
# Environment split:
#   .env       -> dev + testnet (loaded by default). NO mainnet keys, NO Polygon RPC.
#   .env.prod  -> Polygon mainnet only (see .env.prod.example). Load explicitly with
#                ENV_FILE=.env.prod I_UNDERSTAND_MAINNET=1 npx hardhat run scripts/deploy.js --network polygon
#
# NOTE: `.env` and `.env.prod` are gitignored. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# LOCAL TESTING (hardhat / localhost)
# -----------------------------------------------------------------------------
# None of the variables below are REQUIRED to run the local test suite
# (`npm test`, `npm run test:gas`). On the `hardhat`/`localhost` networks,
# scripts/deploy.js falls back to a dummy signing address and deploys mock
# USDC / price-feed contracts, so a fresh clone runs out-of-the-box.
#
# Set OPENADVERTS_SIGNING_ADDRESS only if you want deploy.js to use a specific
# signing address locally; otherwise the local dummy is used automatically.
OPENADVERTS_SIGNING_ADDRESS=

# Optional locally: requestKey ADDRESS (public). If unset, deploy.js uses a local
# dummy distinct from the signing dummy. Must differ from OPENADVERTS_SIGNING_ADDRESS.
OPENADVERTS_REQUEST_KEY_ADDRESS=

# -----------------------------------------------------------------------------
# TESTNET DEPLOYMENT (Amoy / Goerli / Sepolia)
# -----------------------------------------------------------------------------
# Mainnet (Polygon, chainId 137) is deliberately NOT configured here. Its keys
# live in `.env.prod` (see `.env.prod.example`) and are loaded only via
# ENV_FILE=.env.prod, so an accidental `--network polygon` from a dev shell
# fails fast (no RPC / no key). Never put PRIVATEKEYMAINNET in this file.

# Testnet RPC endpoints (POLYGON_RPC_URL is intentionally omitted from this file)
GOERLI_RPC_URL=
AMOY_RPC_URL=
INFURA_API_KEY=

# Testnet/dev deployer key. Defaults to the well-known public Hardhat account #0,
# which MUST never hold real funds. KEEP SECRET if you use a funded testnet key.
PRIVATE_KEY=
PRIVATE_KEY_HH1=

# Contract verification API key (Etherscan V2 unified key works for testnets too)
ETHERSCAN_API_KEY=

# Testnet USDC token address (mainnet USDC lives in .env.prod)
ADDRESS_USDCPOLYGINTEST=
